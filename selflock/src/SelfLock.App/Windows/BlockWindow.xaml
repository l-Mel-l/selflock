<Window x:Class="SelfLock.Windows.BlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SelfLock.UI"
        Title="SelfLock — заблокировано"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource Bg0}" KeyDown="OnKey"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Grid>
        <ui:MountainScene/>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="#99090C1B" Offset="0"/>
                    <GradientStop Color="#EE090C1B" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="Panel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="Rise"/>
            </StackPanel.RenderTransform>
            <Grid Width="120" Height="120">
                <Ellipse Fill="#331C1548" Stroke="#8C7CFF" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#7C5CFF" BlurRadius="60" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="50" Foreground="White"/>
            </Grid>

            <TextBlock x:Name="TitleText" Text="Приложение заблокировано" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,28,0,0"/>
            <TextBlock x:Name="BodyText" FontSize="15" Foreground="#B7BCE6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>

            <Border CornerRadius="16" Background="#B3121730" BorderBrush="#2E3566" BorderThickness="1" Padding="22,16" Margin="0,26,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="30" Foreground="#9FA8FF" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock x:Name="LimitText" FontSize="14.5"/>
                        <TextBlock x:Name="SpentText" FontSize="14.5" Margin="0,4,0,0"/>
                        <TextBlock x:Name="UntilText" FontSize="14.5" Margin="0,4,0,0" Foreground="#B9A8FF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Style="{StaticResource BtnPrimary}" Content="Вернуться к работе" Margin="0,24,0,0" Padding="20,14" FontSize="15" Click="Back"/>
            <TextBlock Text="SelfLock — больше контроля. Больше времени на главное." Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="SelfLock.Windows.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SelfLock.UI"
        Title="SelfLock — лимит" Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border Margin="16" CornerRadius="18" BorderThickness="1" Effect="{StaticResource SoftShadow}" Background="{StaticResource Bg1}">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4D6D" Offset="0"/>
                <GradientStop Color="#7C5CFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <StackPanel Margin="20,16,20,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Сейчас" Style="{StaticResource Sub}" FontSize="12"/>
                <Image Source="pack://application:,,,/Assets/selflock.ico" Width="20" Height="20"/>
                <TextBlock Text="SelfLock" Margin="8,0,0,0" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Red}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF4D6D" BlurRadius="22" ShadowDepth="0" Opacity="0.7"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Достигнут лимит времени!" Style="{StaticResource H2}" FontSize="18"/>
                    <TextBlock x:Name="BodyText" Style="{StaticResource Sub}" FontSize="13.5" Margin="0,4,0,0" LineHeight="19"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource InnerBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Red}"/>
                        <TextBlock x:Name="CountdownLabel" Text="Закроется через" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar x:Name="CountdownBar" Style="{StaticResource Bar}" Margin="0,8,0,0" Foreground="{StaticResource Red}"/>
                </StackPanel>
            </Border>

            <DockPanel x:Name="ChoosePanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="Отложить на" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13"/>
                <ui:Stepper x:Name="SnoozeStepper" HorizontalAlignment="Right" Width="180"/>
            </DockPanel>

            <TextBlock x:Name="UsedText" Text="Отсрочка уже использована — закончите дело и отдохните." Visibility="Collapsed"
                       Style="{StaticResource Sub}" Margin="0,14,0,0"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SnoozeCol"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SnoozeButton" Style="{StaticResource BtnPrimary}" Click="SnoozeClick"/>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource BtnGhost}" Content="Закрыть сейчас" Click="CloseClick"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

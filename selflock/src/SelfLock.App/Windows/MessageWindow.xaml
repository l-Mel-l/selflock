<Window x:Class="SelfLock.Windows.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfLock" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border Margin="20" CornerRadius="18" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            Effect="{StaticResource SoftShadow}" MouseLeftButtonDown="Drag">
        <StackPanel Margin="26,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="20" Foreground="#B9A8FF"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BodyText" Style="{StaticResource Sub}" FontSize="13.5" Margin="0,6,0,0" LineHeight="20"/>
                </StackPanel>
            </Grid>
            <Button Style="{StaticResource BtnPrimary}" Content="Понятно" Margin="0,22,0,0" HorizontalAlignment="Right" Click="Ok" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>

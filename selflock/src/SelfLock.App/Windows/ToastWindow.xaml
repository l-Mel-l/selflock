<Window x:Class="SelfLock.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfLock" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border x:Name="Card" Margin="16" CornerRadius="16" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            Effect="{StaticResource SoftShadow}" MouseLeftButtonUp="Dismiss" Cursor="Hand">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="0"/>
        </Border.RenderTransform>
        <Grid Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGrad}" VerticalAlignment="Top">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="18" Foreground="White"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="SelfLock" Style="{StaticResource Sub}" FontSize="11.5"/>
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="14.5"/>
                </DockPanel>
                <TextBlock x:Name="BodyText" Style="{StaticResource Sub}" Margin="0,4,0,0" LineHeight="18"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

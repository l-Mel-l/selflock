<Window x:Class="SelfLock.Windows.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SelfLock.UI"
        Title="SelfLock — ограничение" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C9CDF2"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </Window.Resources>
    <Border Margin="20" CornerRadius="20" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Margin="26,22,18,6" MouseLeftButtonDown="Drag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentGrad}" Effect="{StaticResource Glow}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="20" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="Добавить ограничение" Style="{StaticResource H2}" FontSize="19"/>
                    <TextBlock Text="Выберите, что и как ограничить. Решение принимается сейчас — спокойно и заранее." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource BtnChromeClose}" Content="&#xE8BB;" VerticalAlignment="Top" Click="Cancel"/>
            </Grid>

            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,22,0">
                <StackPanel Margin="0,0,4,0">
                    <!-- Что ограничиваем -->
                    <Border Style="{StaticResource SegHost}" Margin="0,14,0,0">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="KindApp" Style="{StaticResource Seg}" GroupName="kind" Checked="KindChanged">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Приложение"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="KindSite" Style="{StaticResource Seg}" GroupName="kind" Checked="KindChanged">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Сайт"/></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- Приложение -->
                    <StackPanel x:Name="AppPanel">
                        <TextBox x:Name="AppSearch" Style="{StaticResource Input}" Tag="Поиск приложения…" Margin="0,14,0,8" TextChanged="AppSearchChanged"/>
                        <Border Style="{StaticResource InnerBorder}" Padding="4" Height="214">
                            <ListBox x:Name="AppList" Style="{StaticResource PickList}" SelectionChanged="AppSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <ui:ResourceBadge Width="30" Height="30" Look="{Binding Look}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Process}" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="12,0" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessBox" Style="{StaticResource Input}" Tag="или имя процесса, например steam" TextChanged="ProcessTyped"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Click="Browse">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Выбрать .exe"/></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Сайт -->
                    <StackPanel x:Name="SitePanel" Visibility="Collapsed">
                        <TextBox x:Name="SiteBox" Style="{StaticResource Input}" Tag="адрес сайта или раздела, например youtube.com/shorts" Margin="0,14,0,0" TextChanged="SiteTyped"/>
                        <TextBlock Text="Можно указать раздел: правило для youtube.com/shorts не затронет обычные видео." Style="{StaticResource Sub}" Margin="2,6,0,0"/>
                        <TextBlock Text="Популярное" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="Presets"/>
                    </StackPanel>

                    <TextBlock Text="Название" Style="{StaticResource Label}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Input}" Tag="как правило будет называться в списке"/>

                    <!-- Условие -->
                    <TextBlock Text="Когда срабатывает" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource SegHost}">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="CondContinuous" Style="{StaticResource Seg}" GroupName="cond" Content="Непрерывно" Checked="CondChanged"/>
                            <RadioButton x:Name="CondDaily" Style="{StaticResource Seg}" GroupName="cond" Content="За день" Checked="CondChanged"/>
                            <RadioButton x:Name="CondWindow" Style="{StaticResource Seg}" GroupName="cond" Content="По времени суток" Checked="CondChanged"/>
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="CondHint" Style="{StaticResource Sub}" Margin="2,8,0,0"/>

                    <DockPanel x:Name="LimitRow" Margin="0,12,0,0">
                        <TextBlock Text="Лимит времени" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        <ui:Stepper x:Name="LimitStepper" HorizontalAlignment="Right" Width="200"/>
                    </DockPanel>

                    <Grid x:Name="WindowRow" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="с" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                        <ui:Stepper x:Name="FromStepper" Grid.Column="1"/>
                        <TextBlock Grid.Column="2" Text="до" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="14,0,10,0"/>
                        <ui:Stepper x:Name="ToStepper" Grid.Column="3"/>
                    </Grid>

                    <!-- Режим -->
                    <TextBlock Text="Что делать при срабатывании" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource SegHost}">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ModeSoft" Style="{StaticResource Seg}" GroupName="mode" Checked="ModeChanged">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Мягкий — с отсрочкой"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeHard" Style="{StaticResource Seg}" GroupName="mode" Checked="ModeChanged">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Жёсткий — сразу"/></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource Sub}" Margin="2,8,0,0"/>

                    <StackPanel x:Name="SoftPanel">
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="Отложить можно один раз на" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <ui:Stepper x:Name="SnoozeStepper" HorizontalAlignment="Right" Width="200"/>
                        </DockPanel>
                        <CheckBox x:Name="ChoosableBox" Style="{StaticResource Toggle}" Margin="0,12,0,0">
                            <TextBlock Text="В момент предупреждения разрешить выбрать отсрочку короче (но не длиннее заданной)" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        </CheckBox>
                    </StackPanel>

                    <DockPanel x:Name="BlockRow" Margin="0,12,0,0">
                        <TextBlock Text="Не открывать повторно в течение" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        <ui:Stepper x:Name="BlockStepper" HorizontalAlignment="Right" Width="200"/>
                    </DockPanel>
                    <TextBlock x:Name="BlockHint" Style="{StaticResource Sub}" Margin="2,8,0,0"/>

                    <Border x:Name="Summary" CornerRadius="12" Padding="14,12" Margin="0,18,0,4" Background="#1A1748" BorderBrush="#3B3196" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="#B9A8FF" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="#D9DBFF"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="26,14,26,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Отмена" Click="Cancel" IsCancel="True"/>
                <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="Добавить" MinWidth="170" Click="Save"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="SelfLock.Windows.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfLock — разрешения" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <Border Margin="20" CornerRadius="20" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            Effect="{StaticResource SoftShadow}" MouseLeftButtonDown="Drag">
        <StackPanel Margin="30,26">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/selflock.ico" Width="44" Height="44"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Что нужно SelfLock для работы" Style="{StaticResource H2}" FontSize="20"/>
                    <TextBlock Text="Всё работает локально, без интернета. Данные не покидают этот компьютер." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <ItemsControl x:Name="Items" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InnerBorder}" Margin="0,0,0,8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="#B9A8FF"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Sub}" Margin="0,3,0,0" LineHeight="18"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Padding="10,4" VerticalAlignment="Top" Background="{Binding StatusBg}">
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding StatusFg}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" LineHeight="18"
                       Text="Права администратора не нужны. Пока вы не разрешите доступ, правила не включаются — SelfLock только покажет, сколько времени вы проводите в приложениях."/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Позже" Click="Later"/>
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="Разрешить и включить защиту" Click="Allow"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

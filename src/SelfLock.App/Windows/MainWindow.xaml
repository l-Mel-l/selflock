<Window x:Class="SelfLock.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SelfLock.UI"
        Title="SelfLock" Width="1220" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Компактная строка правила на главной -->
        <DataTemplate x:Key="RuleCompact">
            <Button Style="{StaticResource BtnTile}" Margin="0,0,0,8" Click="OpenRules" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:ResourceBadge Width="40" Height="40" Look="{Binding Look}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Condition}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6"/>
                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding ProgressBrush}" Height="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,8,0">
                        <TextBlock Text="{Binding Right}" FontSize="12.5" HorizontalAlignment="Right" Foreground="#C9CDF2"/>
                        <Border CornerRadius="8" Padding="8,2" Margin="0,5,0,0" HorizontalAlignment="Right" Background="{Binding StateBg}">
                            <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding StateFg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource Dim}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Полная карточка правила -->
        <DataTemplate x:Key="RuleFull">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:ResourceBadge Width="48" Height="48" CornerRadius="13" Look="{Binding Look}"/>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15.5"/>
                            <Border CornerRadius="8" Padding="8,2" Margin="10,0,0,0" Background="{Binding StateBg}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding StateFg}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Target}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border CornerRadius="8" Padding="9,3" Background="#1B2146" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="11" Foreground="#9FA8FF" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Condition}" FontSize="12" Foreground="#C9CDF2"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Padding="9,3" Background="{Binding ModeBg}">
                                <TextBlock Text="{Binding Mode}" FontSize="12" Foreground="{Binding ModeFg}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Right}" FontSize="12.5" Foreground="#C9CDF2" HorizontalAlignment="Right" Margin="0,0,0,7"/>
                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding ProgressBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="ToggleRule" Tag="{Binding}" ToolTip="Включить / выключить"/>
                        <Button Style="{StaticResource BtnIcon}" Content="&#xE70F;" Margin="10,0,0,0" Click="EditRule" Tag="{Binding}" ToolTip="Изменить"/>
                        <Button Style="{StaticResource BtnIcon}" Content="&#xE74D;" Click="DeleteRule" Tag="{Binding}" ToolTip="Удалить"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <!-- фоновые свечения -->
            <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-380,-260,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#337C5CFF" Offset="0"/>
                        <GradientStop Color="#007C5CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-420" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#224F8BFF" Offset="0"/>
                        <GradientStop Color="#004F8BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ================= Боковая панель ================= -->
                <Border Background="#B30C1024" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,1,0">
                    <Grid Margin="16,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                            <Image Source="pack://application:,,,/Assets/selflock.ico" Width="44" Height="44">
                                <Image.Effect>
                                    <DropShadowEffect Color="#7C5CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
                                </Image.Effect>
                            </Image>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SelfLock" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Больше контроля. Больше&#x0a;времени на главное." Foreground="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,30,0,0">
                            <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Главная" Checked="NavChecked" IsChecked="True"/>
                            <RadioButton x:Name="NavRules" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="Ограничения" Checked="NavChecked"/>
                            <RadioButton x:Name="NavStats" Style="{StaticResource Nav}" Tag="&#xE9D2;" Content="Статистика" Checked="NavChecked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Настройки" Checked="NavChecked"/>
                        </StackPanel>

                        <Border Grid.Row="2" CornerRadius="16" ClipToBounds="True" Margin="0,24,0,14" MaxHeight="300" VerticalAlignment="Bottom" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                            <Grid>
                                <ui:MountainScene/>
                                <TextBlock Text="Контроль&#x0a;начинается с тебя" FontFamily="Segoe Script" FontSize="15" Foreground="#E6DEFF" Opacity="0.92"
                                           Margin="16,16,0,0" VerticalAlignment="Top" LineHeight="22">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-6"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,0,0">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Green}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#34E39A" BlurRadius="10" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusLine" Text="Защита активна" Margin="10,0,0,0" Foreground="{StaticResource Muted}" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= Контент ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель -->
                    <Grid Margin="32,18,12,0" Height="56">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="Главная"/>
                            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="AddTop" Style="{StaticResource BtnPrimary}" Margin="0,4,18,0" Padding="16,9" Click="AddRule">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Добавить ограничение"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnChrome}" Content="&#xE921;" Click="Minimize" ToolTip="Свернуть"/>
                            <Button x:Name="MaxButton" Style="{StaticResource BtnChrome}" Content="&#xE922;" Click="Maximize" ToolTip="Развернуть"/>
                            <Button Style="{StaticResource BtnChromeClose}" Content="&#xE8BB;" Click="CloseClick" ToolTip="Закрыть"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Главная ===== -->
                    <ScrollViewer x:Name="PageHome" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,18,26,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="310"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <!-- Статус -->
                                <Border x:Name="StatusCard" Style="{StaticResource CardBorder}" Padding="20,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="58" Height="58">
                                            <Path x:Name="StatusShield" Stretch="Uniform" Fill="{StaticResource Green}"
                                                  Data="M50,4 C64,14 80,17 92,18 L92,48 C92,74 72,90 50,98 C28,90 8,74 8,48 L8,18 C20,17 36,14 50,4 Z">
                                                <Path.Effect>
                                                    <DropShadowEffect x:Name="StatusGlow" Color="#34E39A" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
                                                </Path.Effect>
                                            </Path>
                                            <TextBlock x:Name="StatusGlyph" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="24" Foreground="#0B2A20" FontWeight="Bold"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="StatusTitle" Text="SelfLock активен" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Green}"/>
                                            <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="StatusAction" Style="{StaticResource BtnGhost}" Margin="0,0,14,0" Visibility="Collapsed" Click="StatusActionClick"/>
                                            <CheckBox x:Name="ActiveToggle" Style="{StaticResource Toggle}" Click="ActiveToggleClick" ToolTip="Включить / выключить защиту"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Активные ограничения -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Все правила →" Click="OpenRules" VerticalAlignment="Center"/>
                                            <TextBlock Text="Активные ограничения" Style="{StaticResource H2}"/>
                                        </DockPanel>
                                        <ItemsControl x:Name="HomeRules" ItemTemplate="{StaticResource RuleCompact}"/>
                                        <Border x:Name="HomeEmpty" Style="{StaticResource InnerBorder}" Padding="18" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Пока нет ни одного ограничения" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12" Text="Начните с того, что сильнее всего отвлекает: YouTube Shorts, TikTok или игра. Правило создаётся за пару минут."/>
                                                <WrapPanel>
                                                    <Button Style="{StaticResource Chip}" Content="YouTube Shorts — жёстко, 15 мин" Click="QuickShorts"/>
                                                    <Button Style="{StaticResource Chip}" Content="YouTube — 30 мин подряд" Click="QuickYouTube"/>
                                                    <Button Style="{StaticResource Chip}" Content="Своё правило…" Click="AddRule"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Ближайшее ограничение + что сейчас на экране -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                                                <TextBlock Text="Ближайшее ограничение" Style="{StaticResource H2}" FontSize="14.5"/>
                                            </StackPanel>
                                            <DockPanel Margin="0,14,0,0">
                                                <ui:ResourceBadge x:Name="NextBadge" Width="40" Height="40"/>
                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NextName" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock x:Name="NextText" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                                                <TextBlock Text="Сейчас на экране" Style="{StaticResource H2}" FontSize="14.5"/>
                                            </StackPanel>
                                            <DockPanel Margin="0,14,0,0">
                                                <ui:ResourceBadge x:Name="NowBadge" Width="40" Height="40"/>
                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NowName" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="NowText" Style="{StaticResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Правая колонка -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Сегодня" Style="{StaticResource H2}"/>
                                        <TextBlock x:Name="TodayDate" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                        <Grid Width="190" Height="190" Margin="0,18,0,8">
                                            <Ellipse Margin="18" Fill="#0F1330"/>
                                            <ui:Ring x:Name="TodayRing" Thickness="14">
                                                <ui:Ring.Effect>
                                                    <DropShadowEffect Color="#7C5CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
                                                </ui:Ring.Effect>
                                            </ui:Ring>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TodayLimited" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TodayTotal" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGrad}" VerticalAlignment="Center"/>
                                            <TextBlock Text="время в ограничиваемых ресурсах" Style="{StaticResource Sub}" Margin="8,0,0,0" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <UniformGrid Columns="2" Margin="0,16,0,0">
                                            <Border Style="{StaticResource InnerBorder}" Margin="0,0,5,0" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock x:Name="TodayTriggers" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="срабатываний" Style="{StaticResource Sub}" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource InnerBorder}" Margin="5,0,0,0" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock x:Name="TodaySnoozes" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="отсрочек" Style="{StaticResource Sub}" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Быстрые действия" Style="{StaticResource H2}" FontSize="14.5" Margin="0,0,0,12"/>
                                        <Button Style="{StaticResource BtnTile}" Click="AddRule" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGrad}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="Добавить ограничение" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BtnTile}" Click="OpenStats" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="10" Background="#2A2466">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="14" Foreground="#B9A8FF"/>
                                                </Border>
                                                <TextBlock Text="Открыть статистику" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="PauseTile" Style="{StaticResource BtnTile}" Click="PauseClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AmberSoft}">
                                                    <TextBlock x:Name="PauseGlyph" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="14" Foreground="{StaticResource Amber}"/>
                                                </Border>
                                                <TextBlock x:Name="PauseText" Text="Пауза на 1 час" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== Ограничения ===== -->
                    <Grid x:Name="PageRules" Grid.Row="1" Visibility="Collapsed" Margin="32,18,26,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterAll" Style="{StaticResource Seg}" GroupName="filter" Content="Все" IsChecked="True" Checked="FilterChanged"/>
                                <RadioButton x:Name="FilterApps" Style="{StaticResource Seg}" GroupName="filter" Content="Приложения" Checked="FilterChanged"/>
                                <RadioButton x:Name="FilterSites" Style="{StaticResource Seg}" GroupName="filter" Content="Сайты" Checked="FilterChanged"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,20">
                            <StackPanel>
                                <ItemsControl x:Name="RulesList" ItemTemplate="{StaticResource RuleFull}"/>
                                <Border x:Name="RulesEmpty" Style="{StaticResource CardBorder}" Padding="30" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="40" Foreground="#6D5CFF"/>
                                        <TextBlock Text="Здесь пока пусто" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                                        <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Text="Добавьте приложение или сайт, который отнимает больше всего времени."/>
                                        <Button Style="{StaticResource BtnPrimary}" Content="Добавить ограничение" HorizontalAlignment="Center" Margin="0,16,0,0" Click="AddRule"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Статистика ===== -->
                    <ScrollViewer x:Name="PageStats" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,18,26,26">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="RangeText" DockPanel.Dock="Right" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Range7" Style="{StaticResource Seg}" GroupName="range" Content="Неделя" IsChecked="True" Checked="RangeChanged"/>
                                        <RadioButton x:Name="Range30" Style="{StaticResource Seg}" GroupName="range" Content="Месяц" Checked="RangeChanged"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <UniformGrid x:Name="Tiles" Columns="4" Margin="0,16,0,0"/>

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="#2B3260"/>
                                            <TextBlock Text="всё время за ПК" Style="{StaticResource Sub}" Margin="6,0,16,0"/>
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource AccentGrad}"/>
                                            <TextBlock Text="в ограничиваемых" Style="{StaticResource Sub}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Время по дням" Style="{StaticResource H2}"/>
                                    </DockPanel>
                                    <Grid x:Name="Chart" Height="230" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Топ приложений и сайтов" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                                        <StackPanel x:Name="TopList"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Последние срабатывания" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                                        <StackPanel x:Name="EventsList"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Настройки ===== -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,18,26,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="#9FA8FF" Margin="0,0,10,0"/>
                                            <TextBlock Text="Основные" Style="{StaticResource H2}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SetAutoStart" Style="{StaticResource Toggle}" Click="SettingClick">
                                            <StackPanel><TextBlock Text="Запускать вместе с Windows"/><TextBlock Style="{StaticResource Sub}" Text="SelfLock стартует свёрнутым в трей — защита работает сразу после включения ПК."/></StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SetTray" Style="{StaticResource Toggle}" Margin="0,16,0,0" Click="SettingClick">
                                            <StackPanel><TextBlock Text="Сворачивать в трей при закрытии"/><TextBlock Style="{StaticResource Sub}" Text="Крестик прячет окно, а ограничения продолжают работать в фоне."/></StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SetNotify" Style="{StaticResource Toggle}" Margin="0,16,0,0" Click="SettingClick">
                                            <StackPanel><TextBlock Text="Показывать уведомления"/><TextBlock Style="{StaticResource Sub}" Text="Напоминание незадолго до лимита и сообщение, когда блокировка закончилась."/></StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" Foreground="#9FA8FF" Margin="0,0,10,0"/>
                                            <TextBlock Text="Предупреждения и учёт" Style="{StaticResource H2}"/>
                                        </StackPanel>
                                        <DockPanel>
                                            <ui:Stepper x:Name="SetPreWarn" DockPanel.Dock="Right"/>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="Напомнить заранее"/><TextBlock Style="{StaticResource Sub}" Text="За сколько минут до лимита (0 — не напоминать)."/></StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,14,0,0">
                                            <ui:Stepper x:Name="SetWarnSeconds" DockPanel.Dock="Right"/>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="Время на ответ"/><TextBlock Style="{StaticResource Sub}" Text="Если не нажать «Отложить», ресурс закроется сам."/></StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,14,0,0">
                                            <ui:Stepper x:Name="SetReset" DockPanel.Dock="Right"/>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="Перерыв, обнуляющий сеанс"/><TextBlock Style="{StaticResource Sub}" Text="Для «непрерывных» правил: короткий перерыв не сбрасывает счётчик."/></StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="#9FA8FF" Margin="0,0,10,0"/>
                                            <TextBlock Text="Защита от себя" Style="{StaticResource H2}"/>
                                        </StackPanel>
                                        <DockPanel>
                                            <ui:Stepper x:Name="SetDelay" DockPanel.Dock="Right"/>
                                            <StackPanel Margin="0,0,14,0"><TextBlock Text="Задержка подтверждения"/><TextBlock Style="{StaticResource Sub}" Text="Выключить, удалить, ослабить правило или поставить паузу можно только после ожидания."/></StackPanel>
                                        </DockPanel>
                                        <CheckBox x:Name="SetLock" Style="{StaticResource Toggle}" Margin="0,16,0,0" Click="SettingClick">
                                            <StackPanel><TextBlock Text="Не менять правило во время блокировки"/><TextBlock Style="{StaticResource Sub}" Text="Пока ресурс заблокирован, его правило нельзя изменить, выключить или удалить."/></StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Подробнее и проверить" Click="OpenPermissions" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Foreground="#9FA8FF" Margin="0,0,10,0"/>
                                                <TextBlock Text="Разрешения" Style="{StaticResource H2}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl x:Name="PermList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="9,2" Background="{Binding StatusBg}">
                                                            <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{Binding StatusFg}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" Foreground="#C9CDF2"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="#9FA8FF" Margin="0,0,10,0"/>
                                            <TextBlock Text="О программе" Style="{StaticResource H2}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" LineHeight="19" Text="SelfLock 1.0 — цифровое благополучие и самоконтроль. Командный проект по дисциплине «Алгоритмизация и программирование», ПензГТУ, кафедра «Программирование»."/>
                                        <Grid Margin="0,12,0,0" x:Name="TeamGrid"/>
                                        <DockPanel Margin="0,14,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Padding="14,7" Content="Открыть папку данных" Click="OpenData"/>
                                            <TextBlock x:Name="DataPath" Style="{StaticResource Sub}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,10,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
